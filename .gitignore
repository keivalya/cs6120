# Vendored upstream checkouts. Each carries its own .git, so committing one
# produces a broken gitlink (mode 160000) with no .gitmodules — an empty dir on
# clone. They are pinned in docs/MANIFEST.json instead.
vendor/
# Compatibility symlinks into the new layout, kept only while the P2 grid drains
# (jobs submitted before the 2026-07-31 reorg invoke run/ and results/ by name).
/run
/results
# (the four vendored clones also keep root symlinks for the same reason)

# Raw rollout data: large, regenerable, and the summary.json beside it is what
# the paper reads.
data/results/**/*.jsonl
data/results/**/episodes.jsonl
*.jsonl.bak

# Generated artifacts
paper/figures/*.png
*.lock.txt
hf_home/
__pycache__/
*.pyc
.ipynb_checkpoints/

# Logs and scratch output — everything under logs/ is a job or build transcript
logs/
*.log
*.out
scratch_*.txt
temp_*.txt
archive/releases/

# exclude all markdown files as requested
*.md
**/*.md

# exclude Claude / agent files
.claude/
/LIBERO-Para
/openvla
/openvla-oft
/lerobot
